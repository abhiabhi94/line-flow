root = true

[*.{kt,kts}]
# The code base predates ktlint's "ktlint_official" style; keep the
# Android Studio conventions it was written in (also what Graph.kt's
# generator emits).
ktlint_code_style = android_studio
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Generated by .scripts/leveldesign/build.py --write; never hand-edited.
[**/app/curious/lineflow/Graph.kt]
ktlint = disabled
